{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug STM32F103C8T6 (OpenOCD)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/main.elf",
      "device": "STM32F103C8",
      "toolchainPrefix": "arm-none-eabi-",
      "gdbPath": "arm-none-eabi-gdb",
      "configFiles": [
        "openocd/stm32f103c8t6.cfg"
      ],
      "svdFile": "${workspaceFolder}/core/stm32f103.svd",
      "runToEntryPoint": "main",
      "showDevDebugOutput": "none"
    }
  ]
}
// "showDevDebugOutput": "raw"
// "verbose" — тоже полезно: показывает человекочитаемые сообщения, но без MI-протокола.
// "showDevDebugOutput": "none"